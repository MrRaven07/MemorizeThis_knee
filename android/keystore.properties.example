# Copy to keystore.properties (git-ignored) and fill in. Create the key once with:
#   keytool -genkeypair -v -keystore ~/keys/memorizethis.jks -alias memorizethis \
#           -keyalg RSA -keysize 2048 -validity 10000
# Back up the .jks file and the passwords: app updates must be signed with the same key.
storeFile=/home/YOU/keys/memorizethis.jks
storePassword=CHANGE_ME
keyAlias=memorizethis
keyPassword=CHANGE_ME
