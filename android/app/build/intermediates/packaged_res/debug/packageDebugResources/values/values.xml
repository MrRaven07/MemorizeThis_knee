<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="colorAccent">#7EE787</color>
    <color name="colorPrimary">#0D1117</color>
    <color name="colorPrimaryDark">#0D1117</color>
    <color name="ic_launcher_background">#0D1117</color>
    <color name="mtBackground">#0D1117</color>
    <string name="app_name">MemorizeThis</string>
    <string name="custom_url_scheme">io.github.mrraven07.memorizethis</string>
    <string name="package_name">io.github.mrraven07.memorizethis</string>
    <string name="title_activity_main">MemorizeThis</string>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/mtBackground</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>